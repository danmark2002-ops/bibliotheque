<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : mêmes règles pour la sauvegarde en ligne et le transfert vers un nouveau téléphone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
